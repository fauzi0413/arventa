// ============================================================================
// PRISMA CONFIGURATION & SUPABASE POOLING SETUP
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS & TYPES
// ============================================================================

enum UserRole {
  PLATFORM_ADMIN
  OWNER
  HOUSEKEEPING
  USER
  TENANT
  CUSTOM
}

enum PropertyType {
  KOS
  KONTRAKAN
  APARTEMEN
  RUKO
}

enum RentalPeriodType {
  HOURLY   // Transit (Khusus Apartemen / Kos Harian)
  DAILY    // Harian
  MONTHLY  // Bulanan
  YEARLY   // Tahunan
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  CLEANING
  RESERVED
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  PARTIAL
}

enum ExpenseCategory {
  MAINTENANCE
  UTILITY
  HOUSEKEEPING_SALARY
  SUPPLIES
  TAX_PBB
  OTHER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

// ============================================================================
// MODEL DEFINITIONS
// ============================================================================

// --- 1. USER & AUTH MANAGEMENT ---
model User {
  id             String    @id @default(uuid())
  supabaseAuthId String?   @unique @map("supabase_auth_id") // Relasi ke auth.users Supabase
  email          String    @unique
  fullName       String    @map("full_name")
  phoneNumber    String?   @map("phone_number")
  avatarUrl      String?   @map("avatar_url")
  role           UserRole  @default(USER)
  isActive       Boolean   @default(true) @map("is_active")

  customRoleId   String?   @map("custom_role_id")
  customRole     Role?     @relation(fields: [customRoleId], references: [id])

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relasi
  ownedProperties         Property[]               @relation("OwnerProperties")
  tenantProfile           TenantProfile?
  expensesCreated         Expense[]                @relation("ExpenseCreatedBy")
  unitAccount             Unit?                    @relation("UnitUserAccount")
  subscriptions           OwnerSubscription[]
  housekeepingAssignments HousekeepingAssignment[]
  auditLogs               AuditLog[]
  unitStatusLogs          UnitStatusLog[]
  announcementsCreated    Announcement[]
  forumPosts              ForumPost[]
  forumComments           ForumComment[]

  @@map("users")
}

model TenantProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  nik            String?  @unique
  ktpImageUrl    String?  @map("ktp_image_url")
  emergencyName  String?  @map("emergency_name")
  emergencyPhone String?  @map("emergency_phone")
  occupation     String?

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  leases         Lease[]

  @@map("tenant_profiles")
}

// --- 2. SAAS SUBSCRIPTION & BILLING (PLATFORM ADMIN) ---
model SaaSPlan {
  id            String   @id @default(uuid())
  name          String   @unique // Contoh: Basic, Business, Pro
  maxProperties Int      @default(1) @map("max_properties")
  maxUnits      Int      @default(10) @map("max_units")
  priceMonthly  Decimal  @map("price_monthly") @db.Decimal(12, 2)
  priceYearly   Decimal  @map("price_yearly") @db.Decimal(12, 2)
  features      String[] @default([])
  status        String   @default("ACTIVE")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subscriptions OwnerSubscription[]

  @@map("saas_plans")
}

model OwnerSubscription {
  id           String             @id @default(uuid())
  ownerId      String             @map("owner_id")
  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  planId       String             @map("plan_id")
  plan         SaaSPlan           @relation(fields: [planId], references: [id])

  status       SubscriptionStatus @default(ACTIVE)
  startDate    DateTime           @map("start_date")
  endDate      DateTime           @map("end_date")
  autoRenew    Boolean            @default(true) @map("auto_renew")

  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  saasInvoices SaaSInvoice[]

  @@map("owner_subscriptions")
}

model SaaSInvoice {
  id             String            @id @default(uuid())
  subscriptionId String            @map("subscription_id")
  subscription   OwnerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  invoiceNumber  String            @unique @map("invoice_number")
  amount         Decimal           @db.Decimal(12, 2)
  status         InvoiceStatus     @default(PENDING)
  paymentProof   String?           @map("payment_proof")
  dueDate        DateTime          @map("due_date")
  paidAt         DateTime?         @map("paid_at")

  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@map("saas_invoices")
}

model SaaSPaymentMethod {
  id            String   @id @default(uuid())
  bankName      String   @map("bank_name")
  accountNumber String   @map("account_number")
  accountHolder String   @map("account_holder")
  badgeColor    String?  @default("bg-[#242823]") @map("badge_color")
  isEnabled     Boolean  @default(true) @map("is_enabled")
  notes         String?  @db.Text

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("saas_payment_methods")
}

// --- 3. DYNAMIC ROLE, PERMISSION & MENU MANAGEMENT ---
model Role {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]
  roleMenus       RoleMenu[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  module      String   // Contoh: "properties", "finance", "housekeeping"
  action      String   // Contoh: "create", "read", "update", "delete"
  description String?

  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MenuItem {
  id        String     @id @default(uuid())
  title     String
  path      String
  icon      String?
  group     String?    @default("UTAMA")
  order     Int        @default(0)
  parentId  String?    @map("parent_id")
  parent    MenuItem?  @relation("MenuSubmenu", fields: [parentId], references: [id])
  children  MenuItem[] @relation("MenuSubmenu")

  createdAt DateTime   @default(now()) @map("created_at")

  roleMenus RoleMenu[]

  @@map("menu_items")
}

model RoleMenu {
  roleId     String   @map("role_id")
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menuItemId String   @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([roleId, menuItemId])
  @@map("role_menus")
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  isEnabled   Boolean  @default(true) @map("is_enabled")
  description String?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

// --- 4. PROPERTY & UNIT INVENTORY ---
model Property {
  id                 String       @id @default(uuid())
  ownerId            String       @map("owner_id")
  owner              User         @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: Cascade)

  name               String
  type               PropertyType
  address            String
  city               String
  description        String?      @db.Text
  coverImage         String?      @map("cover_image")
  hasCleaningService Boolean      @default(true) @map("has_cleaning_service")

  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  // Relasi
  units                   Unit[]
  expenses                Expense[]
  housekeepingAssignments HousekeepingAssignment[]
  announcements           Announcement[]
  forumPosts              ForumPost[]

  @@map("properties")
}

model Unit {
  id                    String           @id @default(uuid())
  propertyId            String           @map("property_id")
  property              Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  unitUserId            String?          @unique @map("unit_user_id")
  unitUser              User?            @relation("UnitUserAccount", fields: [unitUserId], references: [id], onDelete: SetNull)

  unitNumber            String           @map("unit_number")
  floor                 Int              @default(1)
  status                UnitStatus       @default(AVAILABLE)

  allowedPeriod         RentalPeriodType @default(MONTHLY) @map("allowed_period")
  basePrice             Decimal          @map("base_price") @db.Decimal(12, 2)
  transitPrice          Decimal?         @map("transit_price") @db.Decimal(12, 2)
  deposit               Decimal          @default(0) @db.Decimal(12, 2)

  capacity              Int              @default(1)
  dimensions            String?          @default("3x4 m")
  facilities            String[]         @default([])
  description           String?          @db.Text
  imageUrl              String?          @map("image_url")
  roomPassword          String?          @map("room_password")
  roomPasswordLastReset DateTime?        @map("room_password_last_reset")

  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  inventories    UnitInventory[]
  leases         Lease[]
  expenses       Expense[]
  unitStatusLogs UnitStatusLog[]

  @@map("units")
}

model UnitInventory {
  id        String   @id @default(uuid())
  unitId    String   @map("unit_id")
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  itemName  String   @map("item_name")
  quantity  Int      @default(1)
  condition String   @default("Baik")
  imageUrl  String?  @map("image_url")
  notes     String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("unit_inventories")
}

// --- 5. OPERATIONAL & HOUSEKEEPING ASSIGNMENT ---
model HousekeepingAssignment {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, propertyId])
  @@map("housekeeping_assignments")
}

model UnitStatusLog {
  id             String     @id @default(uuid())
  unitId         String     @map("unit_id")
  unit           Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  changedById    String     @map("changed_by_id")
  changedBy      User       @relation(fields: [changedById], references: [id])

  previousStatus UnitStatus @map("previous_status")
  newStatus      UnitStatus @map("new_status")
  notes          String?    @db.Text

  createdAt      DateTime   @default(now()) @map("created_at")

  @@map("unit_status_logs")
}

// --- 6. LEASE & FINANCIAL ---
model Lease {
  id              String           @id @default(uuid())
  unitId          String           @map("unit_id")
  unit            Unit             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenantId        String           @map("tenant_id")
  tenant          TenantProfile    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  rentalPeriod    RentalPeriodType @map("rental_period")
  startDate       DateTime         @map("start_date")
  endDate         DateTime         @map("end_date")
  rentPrice       Decimal          @map("rent_price") @db.Decimal(12, 2)
  securityDeposit Decimal          @default(0) @map("security_deposit") @db.Decimal(12, 2)
  status          LeaseStatus      @default(ACTIVE)

  contractUrl     String?          @map("contract_url")

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  invoices        Invoice[]

  @@map("leases")
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique @map("invoice_number")
  leaseId        String        @map("lease_id")
  lease          Lease         @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  amount         Decimal       @db.Decimal(12, 2)
  utilityAmount  Decimal       @default(0) @map("utility_amount") @db.Decimal(12, 2)
  penaltyAmount  Decimal       @default(0) @map("penalty_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)

  dueDate        DateTime      @map("due_date")
  paidAt         DateTime?     @map("paid_at")
  status         InvoiceStatus @default(PENDING)
  paymentReceipt String?       @map("payment_receipt")

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("invoices")
}

model Expense {
  id          String          @id @default(uuid())
  propertyId  String          @map("property_id")
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?         @map("unit_id")
  unit        Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)

  createdById String          @map("created_by_id")
  createdBy   User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  title       String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  expenseDate DateTime        @map("expense_date")
  receiptUrl  String?         @map("receipt_url")
  notes       String?         @db.Text

  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("expenses")
}

// --- 7. COMMUNITY, ANNOUNCEMENTS & FORUM ---
model Announcement {
  id          String   @id @default(uuid())
  propertyId  String   @map("property_id")
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])

  title       String
  content     String   @db.Text
  isPinned    Boolean  @default(false) @map("is_pinned")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("announcements")
}

model ForumPost {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  authorId   String   @map("author_id")
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  title      String
  content    String   @db.Text

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  comments   ForumComment[]

  @@map("forum_posts")
}

model ForumComment {
  id        String    @id @default(uuid())
  postId    String    @map("post_id")
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String    @map("author_id")
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content   String    @db.Text

  createdAt DateTime  @default(now()) @map("created_at")

  @@map("forum_comments")
}

// --- 8. AUDIT TRAIL & SYSTEM SETTINGS ---
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  entityName String   @map("entity_name")
  entityId   String?  @map("entity_id")
  details    Json?
  ipAddress  String?  @map("ip_address")

  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?

  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}