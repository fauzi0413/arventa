// ============================================================================
// PRISMA CONFIGURATION & SUPABASE POOLING SETUP
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS & TYPES
// ============================================================================

enum UserRole {
  PLATFORM_ADMIN
  OWNER
  HOUSEKEEPING
  TENANT
}

enum PropertyType {
  KOS
  KONTRAKAN
  APARTEMEN
  RUKO
}

enum RentalPeriodType {
  HOURLY   // Transit (Khusus Apartemen / Kos Harian)
  DAILY    // Harian
  MONTHLY  // Bulanan
  YEARLY   // Tahunan
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  CLEANING
  RESERVED
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  PARTIAL
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ExpenseCategory {
  MAINTENANCE
  UTILITY
  HOUSEKEEPING_SALARY
  SUPPLIES
  TAX_PBB
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// ============================================================================
// MODEL DEFINITIONS
// ============================================================================

// --- 1. USER & AUTH MANAGEMENT ---
model User {
  id            String    @id @default(uuid())
  supabaseAuthId String?   @unique @map("supabase_auth_id") // Relasi ke auth.users Supabase
  email         String    @unique
  fullName      String    @map("full_name")
  phoneNumber   String?   @map("phone_number")
  avatarUrl     String?   @map("avatar_url")
  role          UserRole  @default(TENANT)
  
  // Timestamps
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relasi
  ownedProperties   Property[]            @relation("OwnerProperties")
  assignedTasks     MaintenanceTask[]     @relation("AssignedHousekeeping")
  createdTasks      MaintenanceTask[]     @relation("CreatedTasks")
  tenantProfile     TenantProfile?
  expensesCreated   Expense[]             @relation("ExpenseCreatedBy")

  @@map("users")
}

model TenantProfile {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  nik            String?   @unique
  ktpImageUrl    String?   @map("ktp_image_url")
  emergencyName  String?   @map("emergency_name")
  emergencyPhone String?   @map("emergency_phone")
  occupation     String?

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relasi
  leases         Lease[]

  @@map("tenant_profiles")
}

// --- 2. PROPERTY & UNIT INVENTORY ---
model Property {
  id          String       @id @default(uuid())
  ownerId     String       @map("owner_id")
  owner       User         @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: Cascade)
  
  name        String
  type        PropertyType
  address     String
  city        String
  description String?      @db.Text
  coverImage  String?      @map("cover_image")

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relasi
  units       Unit[]
  expenses    Expense[]

  @@map("properties")
}

model Unit {
  id            String           @id @default(uuid())
  propertyId    String           @map("property_id")
  property      Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  unitNumber    String           @map("unit_number") // Contoh: "Kamar 101", "Apt 12B", "Ruko A3"
  floor         Int              @default(1)
  status        UnitStatus       @default(AVAILABLE)
  
  // Opsi Sewa & Harga
  allowedPeriod RentalPeriodType @default(MONTHLY) @map("allowed_period")
  basePrice     Decimal          @map("base_price") @db.Decimal(12, 2)
  transitPrice  Decimal?         @map("transit_price") @db.Decimal(12, 2) // Khusus sewa jam-jaman/transit
  
  capacity      Int              @default(1)
  facilities    String[]         @default([]) // Contoh: ["AC", "WiFi", "Kamar Mandi Dalam"]

  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  // Relasi
  inventories   UnitInventory[]
  leases        Lease[]
  tasks         MaintenanceTask[]

  @@map("units")
}

model UnitInventory {
  id          String   @id @default(uuid())
  unitId      String   @map("unit_id")
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  
  itemName    String   @map("item_name") // Contoh: "AC LG 1PK", "Kasur Springbed 160x200"
  quantity    Int      @default(1)
  condition   String   @default("Baik")  // Contoh: "Baik", "Perlu Perbaikan"
  imageUrl    String?  @map("image_url")
  notes       String?  @db.Text

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("unit_inventories")
}

// --- 3. LEASE & CONTRACT ---
model Lease {
  id             String           @id @default(uuid())
  unitId         String           @map("unit_id")
  unit           Unit             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenantId       String           @map("tenant_id")
  tenant         TenantProfile    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  
  rentalPeriod   RentalPeriodType @map("rental_period")
  startDate      DateTime         @map("start_date")
  endDate        DateTime         @map("end_date")
  rentPrice      Decimal          @map("rent_price") @db.Decimal(12, 2)
  securityDeposit Decimal         @default(0) @map("security_deposit") @db.Decimal(12, 2)
  status         LeaseStatus      @default(ACTIVE)
  
  contractUrl    String?          @map("contract_url") // URL PDF Surat Perjanjian di Supabase Storage

  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Relasi
  invoices       Invoice[]

  @@map("leases")
}

// --- 4. FINANCIAL (INVOICES & EXPENSES) ---
model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique @map("invoice_number") // Contoh: "INV/2026/08/0001"
  leaseId        String        @map("lease_id")
  lease          Lease         @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  
  amount         Decimal       @db.Decimal(12, 2)
  utilityAmount  Decimal       @default(0) @map("utility_amount") @db.Decimal(12, 2) // Tambahan Listrik/Air
  penaltyAmount  Decimal       @default(0) @map("penalty_amount") @db.Decimal(12, 2) // Denda Keterlambatan
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)
  
  dueDate        DateTime      @map("due_date")
  paidAt         DateTime?     @map("paid_at")
  status         InvoiceStatus @default(PENDING)
  paymentReceipt String?       @map("payment_receipt") // URL Bukti Transfer di Supabase Storage

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("invoices")
}

model Expense {
  id          String          @id @default(uuid())
  propertyId  String          @map("property_id")
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdById String          @map("created_by_id")
  createdBy   User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  
  title       String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  expenseDate DateTime        @map("expense_date")
  receiptUrl  String?         @map("receipt_url") // URL Nota/Struk
  notes       String?         @db.Text

  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("expenses")
}

// --- 5. OPERATIONAL & HOUSEKEEPING (dnd-kit Board) ---
model MaintenanceTask {
  id           String       @id @default(uuid())
  unitId       String       @map("unit_id")
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  
  createdById  String       @map("created_by_id")
  createdBy    User         @relation("CreatedTasks", fields: [createdById], references: [id])
  assignedToId String?      @map("assigned_to_id")
  assignedTo   User?        @relation("AssignedHousekeeping", fields: [assignedToId], references: [id])
  
  title        String
  description  String?      @db.Text
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?    @map("due_date")

  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("maintenance_tasks")
}